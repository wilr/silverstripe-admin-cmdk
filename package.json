{
  "name": "silverstripe-admin-cmdk",
  "version": "1.0.0",
  "description": "Adds a cmdk-style command palette to the SilverStripe CMS admin",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilr/silverstripe-admin-cmdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "yarn && yarn lint && yarn test && rm -rf client/dist && NODE_ENV=production webpack --mode production --bail --progress",
    "dev": "NODE_ENV=development webpack --progress",
    "watch": "NODE_ENV=development webpack --watch --progress",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "eslint client/src && stylelint client/src",
    "lint-fix": "eslint client/src --fix"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "client/src"
    ],
    "testMatch": [
      "**/tests/**/*-test.js?(x)"
    ],
    "transform": {
      ".*": "babel-jest"
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        { "modules": "commonjs" }
      ],
      "@babel/preset-react"
    ]
  },
  "dependencies": {
    "cmdk": "^1.1.1"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@silverstripe/eslint-config": "^2",
    "@silverstripe/webpack-config": "^3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.26.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stylelint": "~16.12.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "defaults"
  ]
}
