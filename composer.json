{
    "name": "wilr/silverstripe-admin-cmdk",
    "type": "silverstripe-vendormodule",
    "description": "Adds a cmdk-style command palette (⌘K) to the SilverStripe CMS admin, with a PHP API for registering commands and a pluggable search backend.",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "cms",
        "admin",
        "command palette",
        "cmdk",
        "search"
    ],
    "authors": [
        {
            "name": "Will Rossiter",
            "email": "will.rossiter@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "silverstripe/admin": "^3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Wilr\\AdminCmdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilr\\AdminCmdk\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "silverstripe/vendor-plugin": true,
            "composer/installers": true
        }
    }
}
